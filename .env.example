# Frontend API base (no trailing slash).
# Production / same-origin: /api
# Local: leave unset to use the Vite proxy (/api → localhost:4000),
# or set an absolute backend URL:
# VITE_API_URL=http://localhost:4000/api
VITE_API_URL=/api

# Backend variables: see server/.env.example and server/.env.production.example
