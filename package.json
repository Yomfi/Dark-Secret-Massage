{
  "name": "dark-secret",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "VITE_API_URL=/api vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "php:lint": "node node_modules/php-cli/php-cli.js -v >/dev/null 2>&1 && find public/api -name '*.php' -print0 | xargs -0 -n1 node node_modules/php-cli/php-cli.js -l || (command -v php >/dev/null && find public/api -name '*.php' -print0 | xargs -0 -n1 php -l) || echo 'PHP lint skipped'",
    "test:auth": "node scripts/auth-smoke.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
