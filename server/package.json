{
  "name": "dark-secret-api",
  "version": "1.0.0",
  "private": true,
  "description": "Dark Secret authentication and API service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "DATABASE_URL=\"${DATABASE_URL:-mysql://build:build@127.0.0.1:3306/build}\" prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "migrate:deploy": "node -e \"if (!process.env.DATABASE_URL || !String(process.env.DATABASE_URL).trim()) { console.error('Missing required environment variable: DATABASE_URL'); process.exit(1); }\" && prisma migrate deploy",
    "test:auth": "node --import tsx src/scripts/authSmokeTest.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.16.2",
    "typescript": "^5.9.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5"
  }
}
