PORT=4000
NODE_ENV=development

# MySQL connection (Hostinger format example)
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"
DATABASE_URL="mysql://dark_secret:CHANGE_ME@127.0.0.1:3306/dark_secret"

# Comma-separated allowed frontend origins
CORS_ORIGINS="http://localhost:3000,https://dartscret.havensnet.com"

JWT_ACCESS_SECRET="CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Set COOKIE_DOMAIN only when frontend/API share a parent domain, e.g. .havensnet.com
# COOKIE_DOMAIN=

# Future integrations (placeholders only)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# EMAIL_PROVIDER_API_KEY=
# SMS_PROVIDER_API_KEY=
