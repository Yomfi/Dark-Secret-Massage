# Optional — server defaults to 3000 when PORT is omitted.
PORT=3000
NODE_ENV=development
# HOST=0.0.0.0

# MySQL connection (Hostinger format example)
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"
# Local docker-compose defaults. Production Hostinger DB names remain legacy (see HOSTINGER.md).
DATABASE_URL="mysql://massager_studio:CHANGE_ME@127.0.0.1:3306/massager_studio"

# Comma-separated allowed frontend origins (local Vite on :3000).
# Production same-origin app defaults to https://massagerstudio.com if unset.
CORS_ORIGINS="http://localhost:3000"

JWT_ACCESS_SECRET="CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Cookie settings (dev)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Prefer host-only cookies. Only set for intentional parent-domain sharing:
# COOKIE_DOMAIN=

# Production template: see .env.production.example

# Email recipients (keep separate from SMTP/sender). PHP API reads DS_* keys.
# DS_INFO_EMAIL=info@massagerstudio.com       # system / operational notifications
# DS_ADMIN_EMAIL=admin@massagerstudio.com     # business / partnerships
# DS_CONTACT_EMAIL=contact@massagerstudio.com # public contact + marketplace enquire

# Sender / SMTP — separate from the recipient addresses above.
# DS_MAIL_FROM=info@massagerstudio.com
# DS_MAIL_FROM_NAME=Massager Studio
# DS_MAIL_REPLY_TO=contact@massagerstudio.com
# DS_SMTP_HOST=smtp.hostinger.com
# DS_SMTP_PORT=465
# DS_SMTP_SECURE=ssl
# DS_SMTP_USER=info@massagerstudio.com
# DS_SMTP_PASS=

# Future integrations (placeholders only)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# SMS_PROVIDER_API_KEY=
