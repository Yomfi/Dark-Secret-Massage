# Optional — server defaults to 3000 when PORT is omitted.
PORT=3000
NODE_ENV=development
# HOST=0.0.0.0

# MySQL connection (Hostinger format example)
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"
DATABASE_URL="mysql://dark_secret:CHANGE_ME@127.0.0.1:3306/dark_secret"

# Comma-separated allowed frontend origins (local Vite on :3000).
# Production same-origin app defaults to https://dartscret.havensnet.com if unset.
CORS_ORIGINS="http://localhost:3000"

JWT_ACCESS_SECRET="CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Cookie settings (dev)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Prefer host-only cookies. Only set for intentional parent-domain sharing:
# COOKIE_DOMAIN=

# Production template: see .env.production.example

# Future integrations (placeholders only)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# EMAIL_PROVIDER_API_KEY=
# SMS_PROVIDER_API_KEY=
