# Dark Secret API — production environment template (NO REAL SECRETS)
# Paste into Hostinger Node App → Environment variables.
# Do not commit a real .env / .env.production / .secrets.local file.

NODE_ENV=production

# Hostinger injects PORT for Node apps. If required explicitly, set it in the panel.
# PORT=

# MySQL on the same Hostinger account (hostname is localhost, NOT the DB name)
# Replace YOUR_DB_PASSWORD only — never commit the real password.
DATABASE_URL=mysql://u190513960_darksecret:YOUR_DB_PASSWORD@localhost:3306/u190513960_darksecret

# Exact SPA origin (credentials-enabled CORS; no wildcards)
CORS_ORIGINS=https://dartscret.havensnet.com

# Paste two DIFFERENT secrets from server/.secrets.local (or regenerate)
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_different_long_random_secret

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Leave COOKIE_DOMAIN unset for host-only cookies on api.dartscret.havensnet.com
# COOKIE_DOMAIN=

# Optional; server defaults to 0.0.0.0
# HOST=0.0.0.0
