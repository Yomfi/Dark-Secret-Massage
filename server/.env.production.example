# Massager Studio — production environment template (NO REAL SECRETS)
# Paste into Hostinger Node App → Environment variables.
# One app at https://massagerstudio.com (API + SPA).
# Do not commit a real .env / .env.production / .secrets.local file.

NODE_ENV=production

# Optional — server defaults to 3000 when PORT is omitted.
# Use Hostinger's PORT when the platform provides one; otherwise leave unset or set:
PORT=3000

# MySQL on the same Hostinger account (hostname is localhost, NOT the DB name).
# Hostinger database/user names remain legacy (`u190513960_darksecret`) — do not rename on the host
# without a planned migration. Replace YOUR_DB_PASSWORD only — never commit the real password.
DATABASE_URL=mysql://u190513960_darksecret:YOUR_DB_PASSWORD@localhost:3306/u190513960_darksecret

# Same-origin production; optional but recommended for clarity
CORS_ORIGINS=https://massagerstudio.com

# Paste two DIFFERENT secrets from server/.secrets.local (or regenerate)
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_different_long_random_secret

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Leave COOKIE_DOMAIN unset — same-origin host-only cookies on massagerstudio.com
# COOKIE_DOMAIN=

# Baked into the Vite build (frontend also defaults to /api)
VITE_API_URL=/api

# Optional; server defaults to 0.0.0.0
# HOST=0.0.0.0

# Email recipients (keep separate from SMTP/sender). PHP API reads DS_* keys.
# DS_INFO_EMAIL=info@massagerstudio.com
# DS_ADMIN_EMAIL=admin@massagerstudio.com
# DS_CONTACT_EMAIL=contact@massagerstudio.com

# Sender / SMTP — separate from the recipient addresses above.
# DS_MAIL_FROM=info@massagerstudio.com
# DS_MAIL_FROM_NAME=Massager Studio
# DS_MAIL_REPLY_TO=contact@massagerstudio.com
# DS_SMTP_HOST=smtp.hostinger.com
# DS_SMTP_PORT=465
# DS_SMTP_SECURE=ssl
# DS_SMTP_USER=info@massagerstudio.com
# DS_SMTP_PASS=
