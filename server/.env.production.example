# Dark Secret API — production environment template (NO REAL SECRETS)
# Copy values into Hostinger Node App environment settings.
# Do not commit a real .env.production file.

NODE_ENV=production
PORT=4000

# Hostinger MySQL (replace with your real credentials from hPanel)
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME

# Comma-separated allowlist — must include the SPA origin exactly
CORS_ORIGINS=https://dartscret.havensnet.com

# Generate two DIFFERENT long random secrets (32+ chars). Never reuse.
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_different_long_random_secret

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# HTTPS cookies for credentialed SPA → API requests
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Prefer host-only cookies on api.dartscret.havensnet.com (leave unset).
# Only set if you purposely need a shared parent-domain cookie:
# COOKIE_DOMAIN=.havensnet.com

# Optional bind host override (default 0.0.0.0)
# HOST=0.0.0.0
